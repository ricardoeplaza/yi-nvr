# Dependencies
node_modules/

# Environment / secrets (never commit)
.env
.env.*
!.env.example

# Runtime config (real values, never in git — use the .example files)
infra/cameras.json
infra/go2rtc/go2rtc.yaml
infra/mosquitto/mosquitto.conf

# Storage: videos, processed media, SQLite DB (real data, never in git)
# Dev y Docker comparten ./data y ./recordings en la raíz del repo.
data/
recordings/
apps/api/src/storage/
storage/
*.db
*.db-wal
*.db-shm
*.sqlite

# Builds / generated
dist/
.angular/
# Angular build output copied to apps/api/src/public for serving (keep mockup/)
apps/api/src/public/*
!apps/api/src/public/mockup/

# OpenCode Agent
.opencode

# Logs
*.log
npm-debug.log*

# OS / editor
Thumbs.db
.DS_Store

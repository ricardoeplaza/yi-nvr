# yi-nvr — Environment variables
# Copy this file to `.env` and fill in your values.
# Variables marked REQUIRED must be set; the rest have defaults.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# LAN IP of the NVR as seen by the cameras (FTP upload + MQTT).
# The container cannot auto-detect the host's LAN IP, so this is mandatory.
NVR_PUBLIC_IP=

# API auth token (empty = auth disabled — do NOT leave empty in production)
API_AUTH_TOKEN=

# ── WEB PUSH ─────────────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys (NEVER commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# ── FTP (camera credentials) ─────────────────────────────────────────────────
FTP_USER=camera
FTP_PASS=surveillance123

# ── Video processing (ffmpeg) ────────────────────────────────────────────────
# Path to the ffmpeg binary. Leave empty to use 'ffmpeg' from the system PATH
# (recommended — see README Prerequisites). ffprobe is derived from this path.
FFMPEG_PATH=
# Concurrent ffmpeg processes (1 = safe for low-RAM SBCs)
FFMPEG_CONCURRENCY=1
# Threads per ffmpeg process (2 = do not monopolize SBC cores)
FFMPEG_THREADS=2
# Remove the low-res track (640x360, stream 1) via stream copy — saves ~26%
# of storage. On by default; set to false to keep the low-res track.
REMOVE_LOWRES_TRACK=
# Animated WebP preview: duration (s) and fps
PREVIEW_SECONDS=4
PREVIEW_FPS=6

# ── Retention policy ─────────────────────────────────────────────────────────
RETENTION_DAYS=30
STORAGE_MAX_GB=10

# ── Camera status (CGI probes) ───────────────────────────────────────────────
# TTL (ms) of the in-memory cache for the 3 CGI probes of yi-hack cameras, 0 disables the cache
# GET /cameras/status, GET /cameras/:id/status and GET /cameras/:id/storage
# (+/ftp) probes the camera, ≤ ~3 s).
CAMERA_STATUS_CACHE_TTL_MS=30000

# ── LOCAL DEV ONLY (ignored by docker-compose) ───────────────────────────────
PORT=3000
HOST=0.0.0.0
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
FTP_PORT=21
FTP_HOST=0.0.0.0
# Storage dirs. Dev default: <repo>/data + <repo>/recordings (see paths.js).
# Docker overrides these via docker-compose (DATA_DIR=/app/data, ...).
DATA_DIR=
RECORDINGS_DIR=
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
GO2RTC_URL=http://127.0.0.1:1984

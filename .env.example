# HTTP
PORT=3000
HOST=0.0.0.0
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# FTP (default 21 = the port the camera hardcodes in ftppush.sh, D25. It is a
# privileged port → run the API as root/admin or with CAP_NET_BIND_SERVICE.
# For an alternative port: set FTP_PORT here AND patch ftppush.sh on the
# camera SD — see docs/SD-FIRMWARE-OFFICIAL-SETTINGS.md §5.2.1)
FTP_PORT=21
FTP_HOST=0.0.0.0
FTP_USER=camera
FTP_PASS=surveillance123
# LAN IP of the NVR as seen by the cameras (optional override).
# Empty = auto-detect (first non-internal IPv4 via os.networkInterfaces()).
# Set it if the NVR is multi-homed / behind NAT / in a DMZ.
NVR_PUBLIC_IP=

# Storage
STORAGE_DIR=

# Video processing (ffmpeg)
# How many videos are processed at once (FIFO queue). 1 = only one video's
# ffmpeg run concurrently; a backlog of late clips waits in the queue instead
# of spawning N ffmpeg at once (that OOM'd the Orange Pi). Raise only if the
# SBC has RAM/CPU headroom.
FFMPEG_CONCURRENCY=1
# Threads per ffmpeg process (2 = do not monopolize the SBC cores).
FFMPEG_THREADS=2
# Animated WebP preview: fixed duration (seconds) and fps. 4s @ 6fps = 24
# frames, taken from the first seconds of the clip (any clip length).
PREVIEW_SECONDS=4
PREVIEW_FPS=6

# MQTT (empty = the API runs without a broker; HTTP/FTP keep working)
# Docker compose: mqtt://mosquitto:1883 — Dev local (real LAN broker): mqtt://192.168.14.230:1883
MQTT_BROKER_URL=mqtt://mosquitto:1883

# go2rtc (live view): URL del sidecar (el yaml es manual, ver infra/go2rtc/go2rtc.yaml.example)
# Docker compose: http://go2rtc:1984 — Dev nativo: http://127.0.0.1:1984
GO2RTC_URL=http://go2rtc:1984

# Web Push (generate: npx web-push generate-vapid-keys — NEVER commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Auth (empty = auth disabled, dev only)
API_AUTH_TOKEN=

# Retention
RETENTION_ENABLED=true
RETENTION_DAYS=30
STORAGE_MAX_GB=10

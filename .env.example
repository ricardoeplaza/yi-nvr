# HTTP
PORT=3000
HOST=0.0.0.0
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

# FTP (keep 2121 — do NOT use port 21, it needs root/capabilities)
FTP_PORT=2121
FTP_HOST=0.0.0.0
FTP_USER=camera
FTP_PASS=surveillance123

# Storage
STORAGE_DIR=

# MQTT
MQTT_BROKER_URL=mqtt://mosquitto:1883

# go2rtc
GO2RTC_URL=http://go2rtc:1984
GO2RTC_CONFIG_PATH=infra/go2rtc/go2rtc.yaml

# Web Push (generate: npx web-push generate-vapid-keys — NEVER commit real keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:you@example.com

# Auth (empty = auth disabled, dev only)
API_AUTH_TOKEN=

# Retention
RETENTION_ENABLED=true
RETENTION_DAYS=30
STORAGE_MAX_GB=10
